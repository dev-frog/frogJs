# Editor settings (https://editorconfig.org); see docs/style-guide.md
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# The JavaScript embedded in src/*.cpp uses 2 spaces, like Node.js's lib/;
# editors can't tell it apart from the C++ around it, so mind it by hand

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
